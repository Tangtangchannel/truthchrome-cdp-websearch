{
  "name": "dsh-chromium-websearch",
  "version": "0.6.1",
  "description": "Chromium-backed web search and page fetching over the DevTools Protocol: real tabs, background tabs, no API keys. Ships as a DeepSeek Harness plugin and as a standalone engine for Codex and shell use.",
  "type": "module",
  "license": "GPL-3.0-or-later",
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "files": [
    "index.js",
    "lib/",
    "locale/",
    "scripts/",
    "browse/",
    "icon.svg",
    "cordis.patch.yml",
    "README.md",
    "README.zh-CN.md",
    "SECURITY.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-web": ">=0.2.1-rc.4"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-web": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "node test/run.mjs",
    "accept": "node ./scripts/accept.mjs",
    "accept:fast": "node ./scripts/accept.mjs --skip-live",
    "prepublishOnly": "npm test"
  },
  "author": {
    "name": "大肥鱼 (DeepSeek)"
  },
  "contributors": [
    {
      "name": "amecandy"
    }
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Tangtangchannel/truthchrome-cdp-websearch.git"
  },
  "homepage": "https://github.com/Tangtangchannel/truthchrome-cdp-websearch#readme",
  "bugs": {
    "url": "https://github.com/Tangtangchannel/truthchrome-cdp-websearch/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "websearch",
    "web-search",
    "web-fetch",
    "chromium",
    "cordis"
  ],
  "bin": {
    "browse": "browse/browse.mjs"
  }
}
